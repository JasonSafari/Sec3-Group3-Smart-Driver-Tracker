{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,                          
    "allowJs": true,
    "resolveJsonModule": true,                
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}